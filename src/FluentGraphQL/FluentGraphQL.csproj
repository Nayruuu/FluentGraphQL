<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>FluentGraphQL</PackageId>
		<Authors>Nayruu</Authors>
		<Description>Fluent, type-safe GraphQL query builder for .NET. Compose queries and mutations with a chainable C# API, no code generation. Lightweight, with reproducible benchmarks.</Description>
		<PackageTags>graphql query-builder fluent type-safe dotnet csharp graphql-client mutation query codegen-free lightweight netstandard</PackageTags>
		<RepositoryUrl>https://github.com/Nayruuu/FluentGraphQL</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/Nayruuu/FluentGraphQL</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RootNamespace>FluentGraphQL</RootNamespace>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>10</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Text.Json" Version="9.0.7" />
		<PackageReference Include="Nerdbank.GitVersioning" Version="3.6.146" PrivateAssets="all" />
		<!-- TODO: add Microsoft.SourceLink.GitHub once a feed with nuget.org access is available (source debugging for the published package). -->
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="..\..\PUBLISHING.md">
	    <Link>PUBLISHING.md</Link>
	  </Content>
	</ItemGroup>
</Project>
